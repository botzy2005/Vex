<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window is dark in every mode so the launch never flashes white; the app then applies the chosen theme. -->
    <style name="Theme.VexConnect" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vex_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.VexConnect.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vex_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.VexConnect</item>
    </style>
</resources>
